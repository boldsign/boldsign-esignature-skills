{
    "name": "boldsign-recipes/php-send-from-template",
    "description": "BoldSign starter recipe: send from a template (plain PHP)",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "boldsign/boldsign-php": "3.3.4"
    },
    "require-dev": {
        "phpunit/phpunit": "11.5.57"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "scripts": {
        "start": [
            "Composer\\Config::disableProcessTimeout",
            "php -S 127.0.0.1:3000 public/index.php"
        ],
        "test": "phpunit",
        "check:boldsign": "php scripts/check-boldsign.php"
    },
    "config": {
        "sort-packages": true
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    }
}
