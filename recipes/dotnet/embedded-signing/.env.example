# Copy to .env (git-ignored) or set these as secrets in your hosting or agent environment.
BOLDSIGN_API_KEY=your-sandbox-api-key
# US, EU, CA or AU: the region of your BoldSign account
BOLDSIGN_REGION=US
# The signing secret of your webhook (BoldSign: API > Webhooks > Reveal). Any value works for local tests.
BOLDSIGN_WEBHOOK_SECRET=local-test-secret-change-me
# The signed-in user of your app who signs (this recipe uses a demo user)
SIGNER_NAME=Test Signer
SIGNER_EMAIL=test-signer@boldsign.dev
PORT=3000
